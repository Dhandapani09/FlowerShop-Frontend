{
  "name": "flower-wholesale-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-capable Flower Wholesale Management desktop frontend",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "electron:preview": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.68.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "vite": {
      "rollup": "npm:@rollup/wasm-node@4.68.7"
    }
  },
  "build": {
    "appId": "com.flowerwholesale.desktop",
    "productName": "Flower Wholesale Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
